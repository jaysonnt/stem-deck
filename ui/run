#!/usr/bin/env bash
# Start the pianokb UI (if it is not already up) and open it.
set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PORT="${PIANOKB_UI_PORT:-8765}"
URL="http://127.0.0.1:${PORT}/"

up() {
  curl -fsS -m 1 "${URL}api/state" >/dev/null 2>&1
}

if ! up; then
  systemctl --user start pianokb-ui.service >/dev/null 2>&1 || true
  if ! up; then
    nohup python3 "${HERE}/server.py" >"${TMPDIR:-/tmp}/pianokb-ui.log" 2>&1 &
  fi
  for _ in $(seq 1 80); do
    up && break
    sleep 0.1
  done
fi

if ! up; then
  echo "  the UI did not start — try: systemctl --user status pianokb-ui" >&2
  exit 1
fi

if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null; then
  xdg-open "$URL" >/dev/null 2>&1 || true
fi

echo "  $URL"
